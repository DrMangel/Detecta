{
  "name": "detecta-back",
  "version": "0.0.0",
  "description": "Backend de DETECTA: sistema de alerta temprana y orientación académica",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node --enable-source-maps dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:e2e": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config test/jest-e2e.json --runInBand",
    "bd:crear": "node --env-file=../.env ../docker/postgres/crear-bases.mjs",
    "bd:migrar": "node --env-file=.env dist/persistencia/ejecutar-migraciones.js detecta migrar",
    "bd:revertir": "node --env-file=.env dist/persistencia/ejecutar-migraciones.js detecta revertir",
    "bd:migrar:pruebas": "node --env-file=.env dist/persistencia/ejecutar-migraciones.js detecta_pruebas migrar",
    "bd:revertir:pruebas": "node --env-file=.env dist/persistencia/ejecutar-migraciones.js detecta_pruebas revertir",
    "test:integracion": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config test/jest-integracion.json --runInBand",
    "carga:preparar": "node test/carga/preparar-bases-carga.mjs",
    "carga": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config test/jest-carga.json --runInBand",
    "datos:iniciales": "node dist/comandos/datos-iniciales.js",
    "sincronizar": "node dist/comandos/sincronizar.js",
    "correo:prueba": "node dist/comandos/correo-prueba.js",
    "bd:institucional": "node --env-file=.env ../docker/postgres/cargar-institucional.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/platform-express": "12.5.1",
    "@nestjs/typeorm": "12.0.3",
    "bcrypt": "6.0.0",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.3"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.13",
    "@nestjs/testing": "12.5.1",
    "@types/bcrypt": "6.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/smtp-server": "3.5.13",
    "jest": "30.5.2",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "3.10.1",
    "smtp-server": "3.21.3",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "bcrypt@6.0.0": true
  }
}
