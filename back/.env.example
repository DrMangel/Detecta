# Variables de entorno del backend. Copiar a back/.env y completar.
# Nunca versionar back/.env (ER 3.6.2). Las valida src/validacion-entorno.ts al arrancar.

NODE_ENV=development
PUERTO=3000

# Base propia de DETECTA. Usuario de la aplicación: detecta_app
BD_DETECTA_HOST=localhost
BD_DETECTA_PUERTO=5432
BD_DETECTA_NOMBRE=detecta
BD_DETECTA_USUARIO=
BD_DETECTA_CONTRASENA=
# Opcional (B9): conexiones máximas del pool de la base detecta, de 1 a 50.
# Vacía = 10.
BD_DETECTA_POOL_MAX=
# Opcional (B9): espera máxima por una conexión libre del pool, en ms, de
# 1000 a 60000. Vacía = 10000. Al vencer, la petición responde 503.
BD_DETECTA_CONEXION_ESPERA_MS=

# Base que simula la BD institucional (solo lectura). Usuario: institucional_lector
BD_INSTITUCIONAL_HOST=localhost
BD_INSTITUCIONAL_PUERTO=5432
BD_INSTITUCIONAL_NOMBRE=institucional_demo
BD_INSTITUCIONAL_USUARIO=
BD_INSTITUCIONAL_CONTRASENA=

# Migraciones y pruebas de integración (B2). La aplicación no usa estas variables.
# Usuario dueño del esquema: detecta_migrador (DDL). Nunca lo usa la aplicación.
BD_MIGRADOR_USUARIO=
BD_MIGRADOR_CONTRASENA=
# Base de las pruebas de integración
BD_PRUEBAS_NOMBRE=detecta_pruebas

# Autenticación (B3)
# Secreto de firma del JWT de sesión (HS256): al menos 32 caracteres aleatorios.
JWT_SECRETO=
# Duración fija de la sesión en minutos (D14)
SESION_DURACION_MIN=60
# Atributo Secure de la cookie de sesión. true en producción (obligatorio);
# los navegadores aceptan cookies Secure en http://localhost.
COOKIE_SEGURA=true
# Costo de bcrypt (ER 3.6.2)
BCRYPT_COSTO=12
# Vida del token de activación en minutos (D16)
ACTIVACION_DURACION_MIN=30
# Origen del frontend: enlace de activación y único origen admitido por CORS
URL_FRONTEND=http://localhost:5173

# Sincronización con la BD institucional (B4)
# JSON con el origen (tabla o vista) y el mapeo de campos; sin secretos.
CONECTOR_CONFIGURACION=conector-institucional.ejemplo.json
# Hora HH:MM (hora de Bogotá, UTC-5) de la sincronización nocturna; vacía la
# desactiva. No hay recuperación si el proceso estaba apagado a esa hora.
SINCRONIZACION_HORA_NOCTURNA=02:00
# Secreto del disparo manual por HTTP (Authorization: Bearer ...), al menos
# 32 caracteres; vacío desactiva la ruta POST /sincronizacion (responde 404).
SINCRONIZACION_SECRETO=

# Notificaciones por correo (B5): Brevo por SMTP con STARTTLS (puerto 587).
# Sin la configuración SMTP la aplicación no arranca, salvo CORREO_MODO=desactivado
# (no envía correos y avisa al arrancar; prohibido con NODE_ENV=production).
CORREO_MODO=smtp
CORREO_SMTP_HOST=smtp-relay.brevo.com
CORREO_SMTP_PUERTO=587
# Usuario y clave SMTP de Brevo (secretos: solo en back/.env)
CORREO_SMTP_USUARIO=
CORREO_SMTP_CLAVE=
# Remitente verificado en Brevo
CORREO_REMITENTE=
CORREO_REMITENTE_NOMBRE=DETECTA

# Rendimiento (B9)
# Opcional: hilos de libuv, de 1 a 128; vacía = 4 (valor de Node). bcrypt hace
# el hash en esos hilos: con 4, los inicios de sesión simultáneos se atienden
# de 4 en 4. Se aplica al arrancar desde el entorno o desde este archivo (si
# viene de los dos, manda el entorno).
UV_THREADPOOL_SIZE=
