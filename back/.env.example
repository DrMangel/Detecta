# Variables de entorno del backend. Copiar a back/.env y completar.
# Nunca versionar back/.env (ER 3.6.2). Las valida src/validacion-entorno.ts al arrancar.

NODE_ENV=development
PUERTO=3000

# Base propia de DETECTA. Usuario de la aplicación: detecta_app
BD_DETECTA_HOST=localhost
