# Frontend de DETECTA. Sin secretos: Vite incrusta en el código del navegador
# toda variable VITE_*.

# Prefijo de la API. En desarrollo, el proxy de Vite redirige /api/* al
# backend (y quita el prefijo) para que el navegador vea un solo sitio
# (cookie SameSite=Strict, línea base §5).
VITE_URL_API=/api
