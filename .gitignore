# Dependencias
node_modules/

# Variables de entorno y credenciales (ER 3.6.2): solo se versionan los
# ejemplos sin valores (.env.example y, desde F6, demo/.env.remoto.example)
.env
.env.*
!.env.example
!.env.remoto.example

# Archivos generados
dist/
build/
coverage/
*.tsbuildinfo

# Logs
*.log

# Sistema operativo
.DS_Store
Thumbs.db

# Editores
.vscode/*
!.vscode/extensions.json

# Salida de Playwright CLI (puede contener credenciales)
.playwright-cli/

# Datos iniciales reales: contienen datos personales (Ley 1581). Solo se
# versiona el archivo de ejemplo con datos ficticios.
back/datos-iniciales*.json
!back/datos-iniciales.ejemplo.json
