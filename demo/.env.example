# Variables del entorno de demostración (F5a). Copiar a demo/.env (fuera de
# git) y completar los secretos locales; nunca versionar demo/.env (ER 3.6.2).
# Los scripts de scripts/ cargan este archivo con `node --env-file`; sus valores
# tienen prioridad sobre back/.env. Por eso debe declarar TODAS las claves que
# eligen base: así la demo nunca toca detecta ni institucional_demo.
# Las valida back/src/validacion-entorno.ts al arrancar.

NODE_ENV=development
PUERTO=3000

# Base aislada de DETECTA para la demo. Usuario de la aplicación: detecta_app
BD_DETECTA_HOST=localhost
BD_DETECTA_PUERTO=5432
BD_DETECTA_NOMBRE=detecta_entrega
BD_DETECTA_USUARIO=
BD_DETECTA_CONTRASENA=
# Opcional (B9): conexiones máximas del pool, de 1 a 50. Vacía = 10.
BD_DETECTA_POOL_MAX=
# Opcional (B9): espera máxima por una conexión libre, en ms. Vacía = 10000.
BD_DETECTA_CONEXION_ESPERA_MS=

# Base institucional aislada de la demo (solo lectura). Usuario: institucional_lector
BD_INSTITUCIONAL_HOST=localhost
BD_INSTITUCIONAL_PUERTO=5432
BD_INSTITUCIONAL_NOMBRE=institucional_entrega
BD_INSTITUCIONAL_USUARIO=
BD_INSTITUCIONAL_CONTRASENA=

# Migraciones de detecta_entrega: usuario dueño del esquema (DDL).
# La aplicación nunca lo usa.
BD_MIGRADOR_USUARIO=
BD_MIGRADOR_CONTRASENA=

# Autenticación (B3)
# Secreto de firma del JWT de sesión (HS256): al menos 32 caracteres aleatorios.
JWT_SECRETO=
# Duración fija de la sesión en minutos (D14)
SESION_DURACION_MIN=60
# Los navegadores aceptan cookies Secure en http://localhost.
COOKIE_SEGURA=true
# Costo de bcrypt (ER 3.6.2)
BCRYPT_COSTO=12
# Vida del token de activación en minutos (D16)
ACTIVACION_DURACION_MIN=30
# Origen del frontend: enlace de activación y único origen admitido por CORS
URL_FRONTEND=http://localhost:5173

# Sincronización con la base institucional (B4). Ruta relativa a back/.
# Para la variante de columnas ficticias: ../demo/conector-institucional-alternativa.ejemplo.json
CONECTOR_CONFIGURACION=../demo/conector-institucional.ejemplo.json
# Vacía: en la demo la sincronización se lanza a mano desde el guion.
SINCRONIZACION_HORA_NOCTURNA=
# Opcional: secreto del disparo manual por HTTP (al menos 32 caracteres).
SINCRONIZACION_SECRETO=

# Notificaciones por correo (B5): Brevo por SMTP con STARTTLS (puerto 587).
CORREO_MODO=smtp
CORREO_SMTP_HOST=smtp-relay.brevo.com
CORREO_SMTP_PUERTO=587
# Usuario y clave SMTP de Brevo: secretos, solo en demo/.env
CORREO_SMTP_USUARIO=
CORREO_SMTP_CLAVE=
# Remitente verificado en Brevo
CORREO_REMITENTE=
CORREO_REMITENTE_NOMBRE=DETECTA
# Obligatorias en la demo (las comprueban los scripts): no se envía a
# @ejemplo.invalid y solo se envía a los alias de soporte.
CORREO_RECHAZAR_EJEMPLO_INVALID=true
CORREO_DESTINO_PERMITIDO=detectasoportetecnico+*@gmail.com

# Rendimiento (B9). Opcional: hilos de libuv, de 1 a 128; vacía = 4.
UV_THREADPOOL_SIZE=
