# Variables que usan docker-compose.yml y el script docker/postgres/crear-bases.mjs.
# Copiar a .env y completar. Nunca versionar .env (ER 3.6.2).

# Contraseña del superusuario detecta_user (administración y aprovisionamiento)
POSTGRES_PASSWORD=

# Contraseña del usuario de la aplicación detecta_app (base detecta)
BD_APP_CONTRASENA=

# Contraseña del usuario de solo lectura institucional_lector (base institucional_demo)
BD_LECTOR_CONTRASENA=
